{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "体检（中文，默认）",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/src/SecSweep.ps1", "-Lang", "zh-CN"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "体检（英文）",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/src/SecSweep.ps1", "-Lang", "en-US"],
      "problemMatcher": []
    },
    {
      "label": "体检（Windows PowerShell 5.1 兼容性）",
      "type": "shell",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/src/SecSweep.ps1", "-Lang", "zh-CN"],
      "problemMatcher": []
    },
    {
      "label": "打开报告目录",
      "type": "shell",
      "command": "explorer",
      "args": ["${workspaceFolder}/out"],
      "problemMatcher": []
    }
  ]
}
