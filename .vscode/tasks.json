{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "sweep: en-US",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/src/SecSweep.ps1", "-Lang", "en-US"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "sweep: zh-CN",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/src/SecSweep.ps1", "-Lang", "zh-CN"],
      "problemMatcher": []
    },
    {
      "label": "sweep: PS 5.1 compat",
      "type": "shell",
      "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/src/SecSweep.ps1", "-Lang", "en-US"],
      "problemMatcher": []
    },
    {
      "label": "open reports",
      "type": "shell",
      "command": "explorer",
      "args": ["${workspaceFolder}/out"],
      "problemMatcher": []
    }
  ]
}
