{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SecSweep (pwsh)",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/src/SecSweep.ps1",
      "args": [],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "SecSweep (zh-CN)",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/src/SecSweep.ps1",
      "args": ["-Lang", "zh-CN"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "SecSweep (en-US, three domains)",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/src/SecSweep.ps1",
      "args": ["-Lang", "en-US", "-Domains", "accounts,persistence,services"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "SecSweep (raw values, no masking)",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/src/SecSweep.ps1",
      "args": ["-IncludeRaw"],
      "cwd": "${workspaceFolder}"
    }
  ]
}
